HALO_API_BASE_URL=https://yourname.halopsa.com/api
HALO_CLIENT_ID=00000000-0000-0000-0000-000000000000
HALO_CLIENT_SECRET=REPLACE_WITH_HALO_CLIENT_SECRET
HALO_TENANT=
HALO_SCOPE=all
HALO_WEBHOOK_SECRET=REPLACE_WITH_SHARED_SECRET

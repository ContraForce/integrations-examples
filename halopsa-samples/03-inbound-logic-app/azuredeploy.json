{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workflowName": {
      "type": "string",
      "defaultValue": "halo-to-cf-inbound"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "haloAuthUrl": { "type": "string" },
    "haloApiBaseUrl": { "type": "string" },
    "haloClientId": { "type": "string" },
    "haloClientSecret": { "type": "securestring" },
    "haloTenant": { "type": "string", "defaultValue": "" },
    "haloClosedStatusId": {
      "type": "int",
      "metadata": { "description": "Numeric Halo status id that represents Closed." }
    },
    "callbackSecret": {
      "type": "securestring",
      "metadata": { "description": "Shared secret expected on X-Halo-Secret header." }
    },
    "cfApiBaseUrl": {
      "type": "string",
      "metadata": { "description": "e.g. https://prod.platform.contraforce.com/api/v2" }
    },
    "cfServiceAccountClientId": { "type": "string" },
    "cfServiceAccountClientSecret": { "type": "securestring" },
    "cfWorkspaceId": { "type": "string" }
  },
  "variables": {
    "haloTokenUrl": "[concat(parameters('haloAuthUrl'), '/token')]",
    "cfBasicAuth": "[base64(concat(parameters('cfServiceAccountClientId'), ':', parameters('cfServiceAccountClientSecret')))]"
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('workflowName')]",
      "location": "[parameters('location')]",
      "identity": { "type": "SystemAssigned" },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "haloTokenUrl": { "type": "string" },
            "haloApiBaseUrl": { "type": "string" },
            "haloClientId": { "type": "string" },
            "haloClientSecret": { "type": "securestring" },
            "haloTenant": { "type": "string" },
            "haloClosedStatusId": { "type": "int" },
            "callbackSecret": { "type": "securestring" },
            "cfApiBaseUrl": { "type": "string" },
            "cfAuthorization": { "type": "securestring" },
            "cfWorkspaceId": { "type": "string" }
          },
          "triggers": {
            "halo_webhook": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "method": "POST",
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer" },
                    "ticket_id": { "type": "integer" }
                  }
                }
              }
            }
          },
          "actions": {
            "check_secret": {
              "type": "If",
              "expression": {
                "not": {
                  "equals": [
                    "@triggerOutputs()?['headers']?['X-Halo-Secret']",
                    "@parameters('callbackSecret')"
                  ]
                }
              },
              "actions": {
                "respond_401": {
                  "type": "Response",
                  "kind": "Http",
                  "inputs": { "statusCode": 401, "body": { "error": "invalid callback secret" } }
                },
                "terminate_failure": {
                  "type": "Terminate",
                  "inputs": { "runStatus": "Failed" },
                  "runAfter": { "respond_401": ["Succeeded"] }
                }
              },
              "else": { "actions": {} },
              "runAfter": {}
            },
            "resolve_ticket_id": {
              "type": "Compose",
              "inputs": "@coalesce(triggerBody()?['ticket_id'], triggerBody()?['id'])",
              "runAfter": { "check_secret": ["Succeeded"] }
            },
            "check_has_ticket_id": {
              "type": "If",
              "expression": {
                "equals": [ "@outputs('resolve_ticket_id')", null ]
              },
              "actions": {
                "respond_no_ticket": {
                  "type": "Response",
                  "kind": "Http",
                  "inputs": { "statusCode": 200, "body": { "status": "ignored", "reason": "no ticket id in payload" } }
                },
                "terminate_no_ticket": {
                  "type": "Terminate",
                  "inputs": { "runStatus": "Succeeded" },
                  "runAfter": { "respond_no_ticket": ["Succeeded"] }
                }
              },
              "else": { "actions": {} },
              "runAfter": { "resolve_ticket_id": ["Succeeded"] }
            },
            "get_halo_token": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@parameters('haloTokenUrl')",
                "headers": { "Content-Type": "application/x-www-form-urlencoded" },
                "body": "@{concat('grant_type=client_credentials&scope=all&client_id=', encodeUriComponent(parameters('haloClientId')), '&client_secret=', encodeUriComponent(parameters('haloClientSecret')), if(empty(parameters('haloTenant')), '', concat('&tenant=', encodeUriComponent(parameters('haloTenant')))))}"
              },
              "runAfter": { "check_has_ticket_id": ["Succeeded"] }
            },
            "get_ticket": {
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{concat(parameters('haloApiBaseUrl'), '/Tickets/', string(outputs('resolve_ticket_id')))}",
                "headers": {
                  "Authorization": "@{concat('Bearer ', body('get_halo_token').access_token)}"
                }
              },
              "runAfter": { "get_halo_token": ["Succeeded"] }
            },
            "parse_external_reference": {
              "type": "Compose",
              "inputs": {
                "value": "@coalesce(body('get_ticket')?['thirdpartynumber'], '')",
                "parts": "@split(coalesce(body('get_ticket')?['thirdpartynumber'], ''), '|')"
              },
              "runAfter": { "get_ticket": ["Succeeded"] }
            },
            "check_is_cf_ticket": {
              "type": "If",
              "expression": {
                "or": [
                  { "less": [ "@length(outputs('parse_external_reference').parts)", 3 ] },
                  { "not": { "equals": [ "@outputs('parse_external_reference').parts[0]", "cf" ] } }
                ]
              },
              "actions": {
                "respond_not_cf": {
                  "type": "Response",
                  "kind": "Http",
                  "inputs": { "statusCode": 200, "body": { "status": "ignored", "reason": "not a CF-linked ticket" } }
                },
                "terminate_not_cf": {
                  "type": "Terminate",
                  "inputs": { "runStatus": "Succeeded" },
                  "runAfter": { "respond_not_cf": ["Succeeded"] }
                }
              },
              "else": { "actions": {} },
              "runAfter": { "parse_external_reference": ["Succeeded"] }
            },
            "get_latest_action": {
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{concat(parameters('haloApiBaseUrl'), '/Actions?ticket_id=', string(outputs('resolve_ticket_id')), '&count=1&orderby=id+desc')}",
                "headers": {
                  "Authorization": "@{concat('Bearer ', body('get_halo_token').access_token)}"
                }
              },
              "runAfter": { "check_is_cf_ticket": ["Succeeded"] }
            },
            "extract_latest_action": {
              "type": "Compose",
              "inputs": "@first(coalesce(body('get_latest_action')?['actions'], body('get_latest_action'), json('[]')))",
              "runAfter": { "get_latest_action": ["Succeeded"] }
            },
            "post_comment_to_cf": {
              "type": "If",
              "expression": {
                "and": [
                  { "not": { "equals": [ "@outputs('extract_latest_action')", null ] } },
                  { "equals": [ "@coalesce(outputs('extract_latest_action')?['hiddenfromuser'], false)", false ] },
                  {
                    "greater": [
                      "@length(coalesce(outputs('extract_latest_action')?['note_html'], outputs('extract_latest_action')?['note'], ''))",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "send_cf_comment": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{concat(parameters('cfApiBaseUrl'), '/workspaces/', parameters('cfWorkspaceId'), '/incidents/', encodeUriComponent(outputs('parse_external_reference').parts[2]), '/comments')}",
                    "headers": {
                      "Authorization": "@{concat('Basic ', parameters('cfAuthorization'))}",
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "incidentId": "@outputs('parse_external_reference').parts[2]",
                      "content": "@{concat('[Halo ticket #', string(outputs('resolve_ticket_id')), ' note by ', coalesce(outputs('extract_latest_action')?['who'], 'Halo'), ']\n\n', coalesce(outputs('extract_latest_action')?['note_html'], outputs('extract_latest_action')?['note'], ''))}",
                      "source": "@outputs('parse_external_reference').parts[1]"
                    }
                  }
                }
              },
              "else": { "actions": {} },
              "runAfter": { "extract_latest_action": ["Succeeded"] }
            },
            "check_closed": {
              "type": "If",
              "expression": {
                "equals": [ "@body('get_ticket')?['status_id']", "@parameters('haloClosedStatusId')" ]
              },
              "actions": {
                "close_cf_incident": {
                  "type": "Http",
                  "inputs": {
                    "method": "PUT",
                    "uri": "@{concat(parameters('cfApiBaseUrl'), '/workspaces/', parameters('cfWorkspaceId'), '/incidents/', encodeUriComponent(outputs('parse_external_reference').parts[2]), '/status')}",
                    "headers": {
                      "Authorization": "@{concat('Basic ', parameters('cfAuthorization'))}",
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "incidentId": "@outputs('parse_external_reference').parts[2]",
                      "source": "@outputs('parse_external_reference').parts[1]",
                      "status": "Closed",
                      "comment": "@{concat('Closed in HaloPSA (ticket #', string(outputs('resolve_ticket_id')), ').')}",
                      "classification": "Undetermined",
                      "classificationReason": "InaccurateData"
                    }
                  }
                }
              },
              "else": { "actions": {} },
              "runAfter": { "post_comment_to_cf": ["Succeeded", "Skipped"] }
            },
            "respond_ok": {
              "type": "Response",
              "kind": "Http",
              "inputs": { "statusCode": 200, "body": { "status": "processed" } },
              "runAfter": { "check_closed": ["Succeeded", "Skipped"] }
            }
          }
        },
        "parameters": {
          "haloTokenUrl": { "value": "[variables('haloTokenUrl')]" },
          "haloApiBaseUrl": { "value": "[parameters('haloApiBaseUrl')]" },
          "haloClientId": { "value": "[parameters('haloClientId')]" },
          "haloClientSecret": { "value": "[parameters('haloClientSecret')]" },
          "haloTenant": { "value": "[parameters('haloTenant')]" },
          "haloClosedStatusId": { "value": "[parameters('haloClosedStatusId')]" },
          "callbackSecret": { "value": "[parameters('callbackSecret')]" },
          "cfApiBaseUrl": { "value": "[parameters('cfApiBaseUrl')]" },
          "cfAuthorization": { "value": "[variables('cfBasicAuth')]" },
          "cfWorkspaceId": { "value": "[parameters('cfWorkspaceId')]" }
        }
      }
    }
  ]
}

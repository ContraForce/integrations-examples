SNOW_INSTANCE_URL=https://dev12345.service-now.com
SNOW_USERNAME=contraforce.integration
SNOW_PASSWORD=REPLACE_WITH_SNOW_PASSWORD
SNOW_CALLBACK_SECRET=REPLACE_WITH_SHARED_SECRET
SNOW_RESOLVED_STATE=6
SNOW_CLOSED_STATE=7
# Forward internal work_notes in addition to customer-visible comments.
SNOW_FORWARD_WORK_NOTES=false
# Username the integration authenticates as — its journal entries are skipped
# to avoid echo loops.
SNOW_INTEGRATION_USER=contraforce.integration

CF_API_BASE_URL=https://prod.platform.contraforce.com/api/v2

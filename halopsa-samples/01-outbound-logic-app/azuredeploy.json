{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workflowName": {
      "type": "string",
      "defaultValue": "cf-to-halo-outbound",
      "metadata": { "description": "Logic App workflow name." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "keyVaultName": {
      "type": "string",
      "metadata": { "description": "Key Vault holding the secret named 'cf-webhook-secret'." }
    },
    "haloAuthUrl": {
      "type": "string",
      "metadata": { "description": "Halo authorization-server URL, e.g. https://yourname.halopsa.com/auth" }
    },
    "haloApiBaseUrl": {
      "type": "string",
      "metadata": { "description": "Halo REST API base URL, e.g. https://yourname.halopsa.com/api" }
    },
    "haloClientId": {
      "type": "string",
      "metadata": { "description": "Halo OAuth2 client_id (GUID)." }
    },
    "haloClientSecret": {
      "type": "securestring",
      "metadata": { "description": "Halo OAuth2 client_secret." }
    },
    "haloTenant": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Optional tenant slug (hosted multi-tenant Halo). Leave empty otherwise." }
    },
    "haloDefaultTicketTypeId": {
      "type": "int",
      "metadata": { "description": "Numeric id of the Halo ticket type to use for new tickets." }
    },
    "haloDefaultClientId": {
      "type": "int",
      "metadata": { "description": "Numeric id of the Halo client (customer) the ticket belongs to." }
    }
  },
  "variables": {
    "haloTokenUrl": "[concat(parameters('haloAuthUrl'), '/token')]"
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('workflowName')]",
      "location": "[parameters('location')]",
      "identity": { "type": "SystemAssigned" },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "keyVaultName": { "type": "string" },
            "haloTokenUrl": { "type": "string" },
            "haloApiBaseUrl": { "type": "string" },
            "haloClientId": { "type": "string" },
            "haloClientSecret": { "type": "securestring" },
            "haloTenant": { "type": "string" },
            "haloDefaultTicketTypeId": { "type": "int" },
            "haloDefaultClientId": { "type": "int" }
          },
          "triggers": {
            "cf_webhook": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "method": "POST",
                "schema": {}
              }
            }
          },
          "actions": {
            "get_cf_secret": {
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{concat('https://', parameters('keyVaultName'), '.vault.azure.net/secrets/cf-webhook-secret?api-version=7.4')}",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://vault.azure.net"
                }
              },
              "runAfter": {}
            },
            "verify_signature": {
              "type": "JavaScriptCode",
              "inputs": {
                "code": "const crypto = require('crypto');\nconst secret = workflowContext.actions.get_cf_secret.outputs.body.value;\nconst headers = workflowContext.trigger.outputs.headers;\nconst timestamp = headers['X-CF-Timestamp'];\nconst rawBody = workflowContext.trigger.outputs.body;\nconst bodyString = typeof rawBody === 'string' ? rawBody : JSON.stringify(rawBody);\nconst received = headers['X-CF-Signature'] || '';\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(`${timestamp}.${bodyString}`).digest('hex');\nconst a = Buffer.from(expected);\nconst b = Buffer.from(received);\nconst valid = a.length === b.length && crypto.timingSafeEqual(a, b);\nreturn { valid, eventId: headers['X-CF-Event-Id'], schema: headers['X-CF-Schema'] };"
              },
              "runAfter": { "get_cf_secret": ["Succeeded"] }
            },
            "reject_if_invalid": {
              "type": "If",
              "expression": {
                "equals": [ "@body('verify_signature').valid", false ]
              },
              "actions": {
                "respond_401": {
                  "type": "Response",
                  "kind": "Http",
                  "inputs": {
                    "statusCode": 401,
                    "body": { "error": "invalid signature" }
                  }
                },
                "terminate_failure": {
                  "type": "Terminate",
                  "inputs": { "runStatus": "Failed" },
                  "runAfter": { "respond_401": ["Succeeded"] }
                }
              },
              "else": { "actions": {} },
              "runAfter": { "verify_signature": ["Succeeded"] }
            },
            "parse_body": {
              "type": "ParseJson",
              "inputs": {
                "content": "@triggerBody()",
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string" },
                    "timestamp": { "type": "string" },
                    "isTest": { "type": "boolean" },
                    "occurredAt": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "accountId": { "type": "string" },
                        "accountName": { "type": "string" },
                        "incidentId": { "type": "string" },
                        "incidentNumber": { "type": "integer" },
                        "title": { "type": "string" },
                        "description": { "type": "string" },
                        "severity": { "type": "string" },
                        "source": { "type": "string" },
                        "sourceDisplayName": { "type": "string" },
                        "createdAt": { "type": "string" }
                      }
                    }
                  }
                }
              },
              "runAfter": { "reject_if_invalid": ["Succeeded"] }
            },
            "get_halo_token": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@parameters('haloTokenUrl')",
                "headers": { "Content-Type": "application/x-www-form-urlencoded" },
                "body": "@{concat('grant_type=client_credentials&scope=all&client_id=', encodeUriComponent(parameters('haloClientId')), '&client_secret=', encodeUriComponent(parameters('haloClientSecret')), if(empty(parameters('haloTenant')), '', concat('&tenant=', encodeUriComponent(parameters('haloTenant')))))}"
              },
              "runAfter": { "parse_body": ["Succeeded"] }
            },
            "find_existing_ticket": {
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{concat(parameters('haloApiBaseUrl'), '/Tickets?count=1&thirdpartynumber=', encodeUriComponent(concat('cf|', body('parse_body')?['data']?['source'], '|', body('parse_body')?['data']?['incidentId'])))}",
                "headers": {
                  "Authorization": "@{concat('Bearer ', body('get_halo_token').access_token)}"
                }
              },
              "runAfter": { "get_halo_token": ["Succeeded"] }
            },
            "compose_halo_ticket": {
              "type": "Compose",
              "inputs": [
                {
                  "summary": "@{take(concat('[CF #', string(body('parse_body')?['data']?['incidentNumber']), '] ', body('parse_body')?['data']?['title']), 200)}",
                  "details_html": "@{concat('<p><strong>ContraForce incident</strong> ', body('parse_body')?['data']?['incidentId'], ' (#', string(body('parse_body')?['data']?['incidentNumber']), ')</p><ul><li><strong>Severity:</strong> ', body('parse_body')?['data']?['severity'], '</li><li><strong>Source:</strong> ', body('parse_body')?['data']?['sourceDisplayName'], '</li></ul><p>', coalesce(body('parse_body')?['data']?['description'], ''), '</p>')}",
                  "client_id": "@parameters('haloDefaultClientId')",
                  "tickettype_id": "@parameters('haloDefaultTicketTypeId')",
                  "priority_id": "@{if(equals(body('parse_body')?['data']?['severity'], 'High'), 1, if(equals(body('parse_body')?['data']?['severity'], 'Medium'), 2, 3))}",
                  "thirdpartynumber": "@{concat('cf|', body('parse_body')?['data']?['source'], '|', body('parse_body')?['data']?['incidentId'])}"
                }
              ],
              "runAfter": { "find_existing_ticket": ["Succeeded"] }
            },
            "decide_create_or_update": {
              "type": "If",
              "expression": {
                "and": [
                  { "not": { "equals": [ "@coalesce(body('find_existing_ticket'), json('null'))", null ] } },
                  { "greater": [ "@length(coalesce(body('find_existing_ticket')?['tickets'], body('find_existing_ticket'), json('[]')))", 0 ] }
                ]
              },
              "actions": {
                "post_redelivery_note": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{concat(parameters('haloApiBaseUrl'), '/Actions')}",
                    "headers": {
                      "Authorization": "@{concat('Bearer ', body('get_halo_token').access_token)}",
                      "Content-Type": "application/json"
                    },
                    "body": [
                      {
                        "ticket_id": "@{first(coalesce(body('find_existing_ticket')?['tickets'], body('find_existing_ticket')))?['id']}",
                        "outcome": "Private Note",
                        "note_html": "@{concat('<p>ContraForce re-delivered event ', body('verify_signature').eventId, '</p>')}",
                        "hiddenfromuser": true
                      }
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "create_ticket": {
                    "type": "Http",
                    "inputs": {
                      "method": "POST",
                      "uri": "@{concat(parameters('haloApiBaseUrl'), '/Tickets')}",
                      "headers": {
                        "Authorization": "@{concat('Bearer ', body('get_halo_token').access_token)}",
                        "Content-Type": "application/json"
                      },
                      "body": "@outputs('compose_halo_ticket')"
                    }
                  }
                }
              },
              "runAfter": { "compose_halo_ticket": ["Succeeded"] }
            },
            "respond_ok": {
              "type": "Response",
              "kind": "Http",
              "inputs": { "statusCode": 200, "body": { "status": "accepted" } },
              "runAfter": { "decide_create_or_update": ["Succeeded", "Skipped"] }
            }
          }
        },
        "parameters": {
          "keyVaultName": { "value": "[parameters('keyVaultName')]" },
          "haloTokenUrl": { "value": "[variables('haloTokenUrl')]" },
          "haloApiBaseUrl": { "value": "[parameters('haloApiBaseUrl')]" },
          "haloClientId": { "value": "[parameters('haloClientId')]" },
          "haloClientSecret": { "value": "[parameters('haloClientSecret')]" },
          "haloTenant": { "value": "[parameters('haloTenant')]" },
          "haloDefaultTicketTypeId": { "value": "[parameters('haloDefaultTicketTypeId')]" },
          "haloDefaultClientId": { "value": "[parameters('haloDefaultClientId')]" }
        }
      }
    }
  ],
  "outputs": {
    "workflowPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('workflowName')), '2019-05-01', 'Full').identity.principalId]"
    }
  }
}
